rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in (anonymous auth). App Check additionally attests the request
    // comes from the real app once enforcement is turned on in the console.
    function ok() { return request.auth != null; }

    match /om-schedule-assignments/{id}    { allow read, write: if ok(); }
    match /om-schedule-filter-presets/{id} { allow read, write: if ok(); }

    // Salesforce data is read-only for clients; only the Admin SDK (CI) writes it.
    match /om-schedule-sf-data/{id}        { allow read: if ok(); allow write: if false; }

    // Deny everything else by default.
    match /{document=**}                   { allow read, write: if false; }
  }
}
